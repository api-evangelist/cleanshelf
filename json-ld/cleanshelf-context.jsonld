{
  "@context": {
    "@vocab": "https://apievangelist.com/vocab/cleanshelf/",
    "schema": "https://schema.org/",
    "cleanshelf": "https://apievangelist.com/vocab/cleanshelf/",
    "Application": "schema:SoftwareApplication",
    "License": "cleanshelf:SoftwareLicense",
    "Subscription": "cleanshelf:SaaSSubscription",
    "Vendor": "schema:Organization",
    "Contract": "cleanshelf:Contract",
    "User": "schema:Person",
    "Department": "schema:OrganizationRole",
    "name": "schema:name",
    "description": "schema:description",
    "renewalDate": "cleanshelf:renewalDate",
    "annualSpend": "cleanshelf:annualSpend",
    "createdAt": "schema:dateCreated",
    "updatedAt": "schema:dateModified"
  }
}
